{
  "rootDir": "..",
  "testEnvironment": "node",
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "testRegex": "src/.*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.spec.json"
      }
    ]
  },
  "transformIgnorePatterns": ["node_modules", "packages/.*/dist/"],
  "collectCoverageFrom": [
    "src/**/*.(t|j)s"
  ]
}
