DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_voice_automation?schema=public"

REDIS_URL="redis://localhost:6379"

PORT=3010

# Must match apps/backend's APP_ENCRYPTION_KEY exactly -- both decrypt the
# same TelephonyConfig.authToken values (see @ai-voice-automation/telephony-core).
APP_ENCRYPTION_KEY=changeme

# Public HTTPS base URL apps/backend's telephony webhook is reachable at.
# The worker embeds this in the answerUrl/hangupUrl it hands to the
# provider when placing an outbound call.
TELEPHONY_WEBHOOK_BASE_URL=changeme

# How often (ms) the producer polls CallQueue for due rows.
QUEUE_POLL_INTERVAL_MS=2000
# Business-level max attempts before a row is marked FAILED.
QUEUE_MAX_ATTEMPTS=3
# How long (ms) a claimed-but-stuck row is considered locked before it's eligible for recovery.
QUEUE_LOCK_TTL_MS=60000
