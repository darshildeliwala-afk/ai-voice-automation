DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_voice_automation?schema=public"

REDIS_URL="redis://localhost:6379"

PORT=3010

# How often (ms) the producer polls CallQueue for due rows.
QUEUE_POLL_INTERVAL_MS=2000
# Business-level max attempts before a row is marked FAILED.
QUEUE_MAX_ATTEMPTS=3
# How long (ms) a claimed-but-stuck row is considered locked before it's eligible for recovery.
QUEUE_LOCK_TTL_MS=60000
