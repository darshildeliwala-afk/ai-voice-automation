generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Marketplace {
  AMAZON
  FLIPKART
  SHOPIFY
  WOOCOMMERCE
  BLINKIT
  ZEPTO
  MANUAL
  CSV
  API
  WEBHOOK
}

enum PaymentType {
  PREPAID
  COD
  PARTIAL_COD
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum QueueStatus {
  QUEUED
  SCHEDULED
  CALLING
  COMPLETED
  FAILED
  CANCELLED
}

enum CallStatus {
  INITIATED
  RINGING
  CONNECTED
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY
  CANCELLED
  VOICEMAIL
}

enum CallDirection {
  OUTBOUND
  INBOUND
}

enum TelephonyProvider {
  TWILIO
  EXOTEL
  PLIVO
  RETELL
  VAPI
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  AZURE_OPENAI
}

enum ConversationStatus {
  ACTIVE
  COMPLETED
  FAILED
  WAITING_FOR_HUMAN
}

enum ConversationRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL_CALL
  TOOL_RESULT
}

enum ImportJobStatus {
  UPLOADED
  VALIDATED
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportRowStatus {
  PENDING
  VALID
  INVALID
  IMPORTED
  FAILED
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkflowNodeType {
  PROMPT
  CONDITION
  TOOL
  END
  HUMAN_TRANSFER
  CALLBACK
}

enum SttProvider {
  DEEPGRAM
  WHISPER
}

enum TtsProvider {
  ELEVENLABS
  OPENAI
  CARTESIA
}

enum VoicePersonaTone {
  FRIENDLY
  PROFESSIONAL
  SUPPORT
  SALES
  EMPATHETIC
  HEALTHCARE
  BANKING
  COLLECTIONS
}

enum VoiceGender {
  MALE
  FEMALE
  NEUTRAL
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum LeadInterestLevel {
  LOW
  MEDIUM
  HIGH
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AiAgentStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum LiveCallSpeakingParty {
  AI
  CUSTOMER
  SILENCE
}

enum LiveCallAiStatus {
  LISTENING
  THINKING
  SPEAKING
  IDLE
}

enum KnowledgeBaseStatus {
  PENDING
  READY
  FAILED
}

model Workspace {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String
  slug                   String                  @unique
  metadata               Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  users                  User[]
  customers              Customer[]
  orders                 Order[]
  aiAgents               AiAgent[]
  knowledgeBases         KnowledgeBase[]
  marketplaceConnections MarketplaceConnection[]
  importJobs             ImportJob[]
  automations            Automation[]
  workspaceSettings      WorkspaceSettings?
  telephonyConfigs       TelephonyConfig[]
  aiProviderConfigs      AiProviderConfig[]
  calls                  Call[]
  conversations          Conversation[]
  aiUsageRecords         AIUsage[]
  workflows              Workflow[]
  sttProviderConfigs     SttProviderConfig[]
  ttsProviderConfigs     TtsProviderConfig[]
  voicePersonaConfig     VoicePersonaConfig?
  conversationSummaries  ConversationSummary[]
  humanTransferEvents    HumanTransferEvent[]
  leadQualifications     LeadQualification[]
  appointments           Appointment[]
  crmNotes               CrmNote[]
  tagStats               WorkspaceTagStat[]

  @@index([deletedAt])
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @db.Uuid
  name         String
  email        String    @unique
  passwordHash String?
  role         String    @default("ADMIN")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([deletedAt])
}

model Customer {
  id                 String              @id @default(uuid()) @db.Uuid
  workspaceId        String              @db.Uuid
  name               String
  phone              String
  email              String?
  language           String?
  /// Normalized (title-cased, deduplicated) tags -- see CustomerTagService (Sprint 19). Free-form, not an enum, so new tags never need a migration.
  tags               String[]            @default([])
  metadata           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orders             Order[]
  calls              Call[]
  conversations      Conversation[]
  leadQualifications LeadQualification[]
  appointments       Appointment[]
  crmNotes           CrmNote[]

  @@index([workspaceId])
  @@index([phone])
  @@index([workspaceId, deletedAt])
}

model Order {
  id                  String         @id @default(uuid()) @db.Uuid
  workspaceId         String         @db.Uuid
  customerId          String         @db.Uuid
  marketplace         Marketplace
  marketplaceOrderId  String?
  paymentType         PaymentType
  status              OrderStatus    @default(PENDING)
  totalAmount         Decimal        @db.Decimal(12, 2)
  currency            String         @default("INR") @db.VarChar(3)
  shippingAddress     Json?
  notes               String?
  /// Courier/tracking details (Sprint 19 lookup_order tool) -- "shipping status" deliberately reuses `status` above (already has SHIPPED/DELIVERED) rather than a duplicate field.
  courier             String?
  trackingId          String?
  estimatedDeliveryAt DateTime?
  metadata            Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?
  workspace           Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer            Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items               OrderItem[]
  callQueue           CallQueue[]
  calls               Call[]
  conversations       Conversation[]

  @@unique([workspaceId, marketplace, marketplaceOrderId])
  @@index([customerId])
  @@index([marketplaceOrderId])
  @@index([status])
  @@index([workspaceId, deletedAt])
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  name      String
  sku       String?
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model AiAgent {
  id                   String                       @id @default(uuid()) @db.Uuid
  workspaceId          String                       @db.Uuid
  knowledgeBaseId      String?                      @db.Uuid
  name                 String
  description          String?
  provider             String
  model                String
  voice                String
  language             String
  systemPrompt         String?
  greeting             String?
  temperature          Float                        @default(0.7)
  isActive             Boolean                      @default(true)
  /// Richer admin-facing lifecycle field (Sprint 20) -- fully independent of `isActive`, which stays as the pre-existing internal active/inactive gate (see ai-agent.service.ts's name-uniqueness-among-active-agents check).
  status               AiAgentStatus                @default(ACTIVE)
  maxTokens            Int?
  businessGoal         String?
  configuration        Json?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  deletedAt            DateTime?
  workspace            Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledgeBase        KnowledgeBase?               @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  callQueue            CallQueue[]
  conversations        Conversation[]
  workflows            Workflow[]
  voicePersonaOverride AiAgentVoicePersonaOverride?

  @@index([workspaceId])
  @@index([knowledgeBaseId])
  @@index([workspaceId, deletedAt])
}

model CallQueue {
  id           String      @id @default(uuid()) @db.Uuid
  orderId      String      @db.Uuid
  aiAgentId    String?     @db.Uuid
  status       QueueStatus @default(QUEUED)
  scheduledAt  DateTime?
  /// Why this callback was scheduled (Sprint 19 create_callback tool), e.g. "wants a discount". Optional -- pre-existing enqueue() callers never set it.
  reason       String?
  attemptCount Int         @default(0)
  lastError    String?
  startedAt    DateTime?
  completedAt  DateTime?
  lockedAt     DateTime?
  workerId     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  aiAgent      AiAgent?    @relation(fields: [aiAgentId], references: [id], onDelete: Restrict)
  calls        Call[]

  @@index([orderId])
  @@index([aiAgentId])
  @@index([status])
  @@index([scheduledAt])
  @@index([lockedAt])
}

model Call {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @db.Uuid
  orderId         String            @db.Uuid
  customerId      String            @db.Uuid
  callQueueId     String            @db.Uuid
  provider        TelephonyProvider
  providerCallId  String?
  phoneNumber     String
  status          CallStatus
  direction       CallDirection     @default(OUTBOUND)
  startedAt       DateTime?
  answeredAt      DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  recordingUrl    String?
  hangupReason    String?
  providerPayload Json?
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  callQueue       CallQueue         @relation(fields: [callQueueId], references: [id], onDelete: Cascade)
  transcript      Transcript?
  conversation    Conversation?
  liveCallState   LiveCallState?

  @@index([workspaceId])
  @@index([orderId])
  @@index([customerId])
  @@index([callQueueId])
  @@index([startedAt])
  @@index([providerCallId])
}

/// Durable dedup record for provider webhook deliveries. Providers (Plivo
/// included) may redeliver the same event on transient failures; a unique
/// constraint on (provider, providerCallId, eventType) is the idempotency
/// boundary -- a second delivery of the same lifecycle transition for the
/// same call is recognized and ignored rather than double-applied.
model TelephonyWebhookEvent {
  id             String            @id @default(uuid()) @db.Uuid
  provider       TelephonyProvider
  providerCallId String
  eventType      String
  payload        Json
  receivedAt     DateTime          @default(now())

  @@unique([provider, providerCallId, eventType])
  @@index([providerCallId])
}

model Transcript {
  id        String   @id @default(uuid()) @db.Uuid
  callId    String   @unique @db.Uuid
  content   String
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
}

/// A single AI conversation thread, scoped to a workspace and customer.
/// Optionally tied to an order (what the conversation is about), an
/// AiAgent (which persona/config drove it), and a Call (if it happened
/// over the phone -- not required, since the AI provider layer is
/// usable independent of an active voice call).
model Conversation {
  id                  String                @id @default(uuid()) @db.Uuid
  workspaceId         String                @db.Uuid
  customerId          String                @db.Uuid
  orderId             String?               @db.Uuid
  aiAgentId           String?               @db.Uuid
  callId              String?               @unique @db.Uuid
  status              ConversationStatus    @default(ACTIVE)
  /// Resolved language code once detected/confirmed this call (e.g. "hi", "en", "gu"); null until a customer states an explicit preference (Sprint 18 LanguageDetectionService).
  language            String?
  /// Denormalized single source of truth, set once at call-end by CallSummaryService (Sprint 19) -- avoids the LLM-generated summary and a separate heuristic pass ever disagreeing.
  sentiment           Sentiment?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  workspace           Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer            Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order               Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  aiAgent             AiAgent?              @relation(fields: [aiAgentId], references: [id], onDelete: SetNull)
  call                Call?                 @relation(fields: [callId], references: [id], onDelete: SetNull)
  messages            ConversationMessage[]
  usageRecords        AIUsage[]
  summary             ConversationSummary?
  humanTransferEvents HumanTransferEvent[]
  leadQualification   LeadQualification?
  appointments        Appointment[]
  crmNotes            CrmNote[]

  @@index([workspaceId])
  @@index([customerId])
  @@index([orderId])
  @@index([aiAgentId])
}

model ConversationMessage {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @db.Uuid
  role           ConversationRole
  content        String
  metadata       Json?
  createdAt      DateTime         @default(now())
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

/// Per-request AI usage/cost record, primarily for billing and
/// observability. `estimatedCost` is computed from a static per-model
/// pricing table at write time (see ai/pricing) -- not a live lookup.
model AIUsage {
  id               String        @id @default(uuid()) @db.Uuid
  workspaceId      String        @db.Uuid
  conversationId   String?       @db.Uuid
  provider         AiProvider
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedCost    Decimal       @db.Decimal(10, 6)
  latencyMs        Int?
  createdAt        DateTime      @default(now())
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([conversationId])
  @@index([workspaceId, createdAt])
}

model KnowledgeBase {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String              @db.Uuid
  title       String
  description String?
  content     String?
  sourceUrl   String?
  /// System-managed only (Sprint 20) -- not settable via create/update DTOs, mutated only by the reindex endpoint. Defaults READY since content is provided synchronously; no async indexing pipeline exists yet (see KnowledgeBaseService.searchWithRelevance's own doc comment).
  status      KnowledgeBaseStatus @default(READY)
  metadata    Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  aiAgents    AiAgent[]

  @@index([workspaceId])
  @@index([workspaceId, deletedAt])
}

model MarketplaceConnection {
  id                String      @id @default(uuid()) @db.Uuid
  workspaceId       String      @db.Uuid
  marketplace       Marketplace
  credentials       Json
  externalAccountId String?
  lastSyncedAt      DateTime?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?
  workspace         Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, marketplace])
  @@index([workspaceId])
  @@index([workspaceId, deletedAt])
}

model ImportJob {
  id               String          @id @default(uuid()) @db.Uuid
  workspaceId      String          @db.Uuid
  source           Marketplace
  sourceReference  String?
  status           ImportJobStatus @default(UPLOADED)
  fileName         String
  fileType         String
  headers          Json
  suggestedMapping Json
  fieldMapping     Json?
  totalRows        Int             @default(0)
  validRows        Int             @default(0)
  invalidRows      Int             @default(0)
  processedRows    Int             @default(0)
  successCount     Int             @default(0)
  errorCount       Int             @default(0)
  completedAt      DateTime?
  errorMessage     String?
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rows             ImportRow[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

model ImportRow {
  id          String          @id @default(uuid()) @db.Uuid
  importJobId String          @db.Uuid
  rowNumber   Int
  rawData     Json
  mappedData  Json?
  groupKey    String?
  status      ImportRowStatus @default(PENDING)
  errors      Json?
  customerId  String?         @db.Uuid
  orderId     String?         @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  importJob   ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@index([importJobId, status])
  @@index([importJobId, groupKey])
}

model Automation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  name        String
  description String?
  definition  Json
  isEnabled   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
}

/// Single source of truth for a workspace's general configuration. Future
/// provider modules (Telephony, AI, Email, WhatsApp, SMS, Billing, ...)
/// read their non-secret configuration from here.
model WorkspaceSettings {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @unique @db.Uuid
  timezone      String    @default("UTC")
  businessName  String?
  businessEmail String?
  businessPhone String?
  website       String?
  logoUrl       String?
  address       String?
  currency      String    @default("INR") @db.VarChar(3)
  language      String    @default("en")
  businessHours Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Telephony provider credentials for a workspace. `authToken` is encrypted
/// at rest (see EncryptionService) and must never be returned by any API.
/// Multiple rows may exist per workspace (history across provider
/// switches); at most one is `isActive` at a time.
model TelephonyConfig {
  id            String            @id @default(uuid()) @db.Uuid
  workspaceId   String            @db.Uuid
  provider      TelephonyProvider
  authId        String?
  authToken     String
  phoneNumber   String?
  webhookSecret String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, isActive])
}

/// AI provider credentials for a workspace. `apiKey` is encrypted at rest
/// (see EncryptionService) and must never be returned by any API. Multiple
/// rows may exist per workspace; at most one is `isActive` at a time.
model AiProviderConfig {
  id           String     @id @default(uuid()) @db.Uuid
  workspaceId  String     @db.Uuid
  provider     AiProvider
  apiKey       String
  defaultModel String?
  temperature  Float      @default(0.7)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, isActive])
}

/// Streaming speech-to-text provider credentials for a workspace (Sprint 17
/// real-time voice engine). Same insert-only + isActive pattern as
/// AiProviderConfig/TelephonyConfig -- `apiKey` is encrypted at rest and
/// never returned by any API.
model SttProviderConfig {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  provider    SttProvider
  apiKey      String
  language    String      @default("en")
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, isActive])
}

/// Streaming text-to-speech provider credentials for a workspace (Sprint 17
/// real-time voice engine). Same insert-only + isActive pattern as
/// AiProviderConfig/TelephonyConfig -- `apiKey` is encrypted at rest and
/// never returned by any API.
model TtsProviderConfig {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  provider    TtsProvider
  apiKey      String
  voice       String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, isActive])
}

/// Workspace-level default voice/conversation persona (Sprint 18 human-
/// sounding voice engine). One row per workspace, auto-provisioned with
/// defaults on first access -- same findUnique-then-create/upsert pattern
/// as WorkspaceSettings (not the credential isActive-history pattern used
/// by AiProviderConfig/SttProviderConfig/TtsProviderConfig -- this table
/// holds no secrets). Every behavior-driving field carries a concrete
/// default, so this row *is* the materialized "system default" tier that
/// AiAgentVoicePersonaOverride falls back to when unset.
model VoicePersonaConfig {
  id                 String           @id @default(uuid()) @db.Uuid
  workspaceId        String           @unique @db.Uuid
  tone               VoicePersonaTone @default(FRIENDLY)
  /// Free-form language code (e.g. "hi-en" Hinglish, "hi", "en", "gu") --
  /// not an enum; new languages are added via LanguageDetectionService's
  /// registry, never by touching this schema.
  language           String           @default("hi-en")
  voiceGender        VoiceGender?
  /// Provider-specific voice identifier/name; TTS provider adapters
  /// resolve it to their own voice catalog -- schema stays provider-agnostic.
  voiceName          String?
  indianAccent       Boolean          @default(true)
  /// 0.5-2.0, 1.0 = provider-normal speaking rate.
  speakingRate       Float            @default(1.0)
  /// -1.0..1.0, 0 = neutral pitch.
  pitch              Float            @default(0.0)
  /// 0-1, higher = warmer/more expressive delivery.
  warmth             Float            @default(0.5)
  /// 0-1, 0 = fully casual/friendly, 1 = fully formal/professional.
  professionalism    Float            @default(0.5)
  pauseShortMs       Int              @default(300)
  pauseMediumMs      Int              @default(500)
  pauseLongMs        Int              @default(700)
  fillerWordsEnabled Boolean          @default(true)
  bargeInEnabled     Boolean          @default(true)
  /// Soft guidance -- target words per turn, keeps responses conversational.
  maxResponseLength  Int              @default(60)
  /// Overrides MediaSessionConfig's global silence-timeout default per workspace.
  silenceThresholdMs Int              @default(2000)
  greetingStyle      String?
  closingStyle       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Sparse per-AI-Agent override of the workspace's VoicePersonaConfig
/// (Sprint 18). Every field is nullable with no default -- an agent that
/// only wants a different tone sets `tone` and leaves the rest null;
/// VoicePersonaConfigService.resolveEffectiveConfig() reads through to
/// the workspace row for anything unset. This is the literal mechanism
/// for field-level inheritance instead of copying the whole record.
model AiAgentVoicePersonaOverride {
  id                 String            @id @default(uuid()) @db.Uuid
  aiAgentId          String            @unique @db.Uuid
  tone               VoicePersonaTone?
  language           String?
  voiceGender        VoiceGender?
  voiceName          String?
  indianAccent       Boolean?
  speakingRate       Float?
  pitch              Float?
  warmth             Float?
  professionalism    Float?
  pauseShortMs       Int?
  pauseMediumMs      Int?
  pauseLongMs        Int?
  fillerWordsEnabled Boolean?
  bargeInEnabled     Boolean?
  maxResponseLength  Int?
  silenceThresholdMs Int?
  greetingStyle      String?
  closingStyle       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  aiAgent            AiAgent           @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
}

/// A versioned AI Agent conversation workflow: a graph of WorkflowNodes the
/// ConversationEngine executes instead of the fixed single-prompt loop.
/// Rows are insert-only per version (never mutated once PUBLISHED), the
/// same audit-preserving pattern as AiProviderConfig/TelephonyConfig --
/// `slug` groups the versions of one named workflow together, and at most
/// one PUBLISHED version per (workspaceId, slug) is `isActive` at a time.
/// `aiAgentId` null means "workspace-wide default workflow" (used when an
/// agent has no workflow of its own).
model Workflow {
  id           String         @id @default(uuid()) @db.Uuid
  workspaceId  String         @db.Uuid
  aiAgentId    String?        @db.Uuid
  slug         String
  name         String
  description  String?
  version      Int            @default(1)
  status       WorkflowStatus @default(DRAFT)
  isActive     Boolean        @default(false)
  entryNodeKey String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  aiAgent      AiAgent?       @relation(fields: [aiAgentId], references: [id], onDelete: SetNull)
  nodes        WorkflowNode[]

  @@unique([workspaceId, slug, version])
  @@index([workspaceId])
  @@index([workspaceId, isActive])
  @@index([aiAgentId])
  @@index([workspaceId, deletedAt])
}

/// A single step in a Workflow's graph. `config` is a type-specific JSON
/// blob (validated by WorkflowValidatorService, not the DB) that carries
/// both the node's parameters and its outgoing transition(s) -- e.g. a
/// PROMPT/TOOL/CALLBACK node's optional `next` key, or a CONDITION node's
/// `whenTrue`/`whenFalse` keys. END and HUMAN_TRANSFER nodes are always
/// structurally terminal (no transition in their config).
model WorkflowNode {
  id         String           @id @default(uuid()) @db.Uuid
  workflowId String           @db.Uuid
  key        String
  type       WorkflowNodeType
  config     Json
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  workflow   Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, key])
  @@index([workflowId])
}

/// Structured summary auto-generated at the end of every call (Sprint 19
/// business AI skills), 1:1 with Conversation. Sentiment is computed by
/// the lightweight SentimentAnalysisService heuristic (not the LLM) so
/// there is one canonical source of truth; every other field comes from
/// a single structured-JSON LLM call over the conversation transcript.
/// Generated by CallSummaryService, called from EndCallTool -- failure
/// to generate never blocks call termination.
model ConversationSummary {
  id                     String       @id @default(uuid()) @db.Uuid
  workspaceId            String       @db.Uuid
  conversationId         String       @unique @db.Uuid
  customerName           String?
  reason                 String?
  outcome                String?
  sentiment              Sentiment?
  followUpRecommendation String?
  callbackRequired       Boolean      @default(false)
  agentPerformance       String?
  ordersDiscussed        String[]     @default([])
  problems               String[]     @default([])
  createdAt              DateTime     @default(now())
  workspace              Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation           Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Records a request to hand a conversation to a human agent (Sprint 19
/// transfer_to_human tool). No telephony transfer capability exists yet
/// -- this is purely a record + a Conversation.status flip to
/// WAITING_FOR_HUMAN for a future admin/agent-facing flow to act on.
model HumanTransferEvent {
  id             String       @id @default(uuid()) @db.Uuid
  workspaceId    String       @db.Uuid
  conversationId String       @db.Uuid
  reason         String
  createdAt      DateTime     @default(now())
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([conversationId])
}

/// One row per conversation, upsert-merged as the qualify_lead tool
/// learns more fields across multiple calls within that conversation
/// (Prisma's update skips undefined keys, so a call that only knows
/// `budget` never nulls out a `name` learned earlier).
model LeadQualification {
  id             String             @id @default(uuid()) @db.Uuid
  workspaceId    String             @db.Uuid
  customerId     String             @db.Uuid
  conversationId String             @unique @db.Uuid
  name           String?
  company        String?
  /// Free text -- spoken/typed budgets ("50k-1L") aren't reliably numeric.
  budget         String?
  requirement    String?
  timeline       String?
  city           String?
  email          String?
  interestLevel  LeadInterestLevel?
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([customerId])
}

/// Generic booking record (Sprint 19 book_appointment tool). No external
/// calendar integration yet -- pure DB record. `time` is a plain "HH:mm"
/// string (display/comparison only, no time arithmetic needed) rather
/// than a native DB time type, to avoid the epoch-anchoring friction
/// Prisma's @db.Time <-> JS Date round-trip otherwise adds for no benefit.
model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  workspaceId    String            @db.Uuid
  customerId     String            @db.Uuid
  conversationId String?           @db.Uuid
  date           DateTime          @db.Date
  time           String
  timezone       String
  notes          String?
  status         AppointmentStatus @default(SCHEDULED)
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation   Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([customerId])
}

/// Free-form note the AI (via create_crm_note) or an admin can attach to
/// a customer, optionally scoped to the conversation it was written
/// during. Surfaced back through the improved lookup_customer tool.
model CrmNote {
  id             String        @id @default(uuid()) @db.Uuid
  workspaceId    String        @db.Uuid
  customerId     String        @db.Uuid
  conversationId String?       @db.Uuid
  content        String
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([customerId])
}

/// Per-workspace usage count for each normalized tag (Sprint 19
/// CustomerTagService) -- reflects how many customers currently carry
/// the tag (incremented on add, decremented floor-0 on remove, row never
/// deleted), so an admin UI can suggest frequently used tags.
model WorkspaceTagStat {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  tag         String
  usageCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, tag])
  @@index([workspaceId])
}

/// Live in-call state (Sprint 20 admin Live Call API), written by
/// MediaSession at each lifecycle transition during a real-time call and
/// deleted on call end -- a Call no longer live shouldn't appear in
/// "list active calls". 1:1 with Call. All writes from MediaSession are
/// fire-and-forget (never awaited on the audio hot path).
model LiveCallState {
  id                     String                @id @default(uuid()) @db.Uuid
  callId                 String                @unique @db.Uuid
  workspaceId            String                @db.Uuid
  conversationId         String?               @db.Uuid
  currentWorkflowNodeKey String?
  speakingParty          LiveCallSpeakingParty @default(SILENCE)
  aiStatus               LiveCallAiStatus      @default(LISTENING)
  lastTranscriptSnippet  String?
  turnStartedAt          DateTime              @default(now())
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  call                   Call                  @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}
