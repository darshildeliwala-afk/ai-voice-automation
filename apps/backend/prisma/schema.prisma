generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

enum Marketplace {
  AMAZON
  FLIPKART
  SHOPIFY
  WOOCOMMERCE
  BLINKIT
  ZEPTO
  MANUAL
  CSV
  API
  WEBHOOK
}

enum PaymentType {
  PREPAID
  COD
  PARTIAL_COD
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum QueueStatus {
  QUEUED
  SCHEDULED
  CALLING
  COMPLETED
  FAILED
  CANCELLED
}

enum CallStatus {
  INITIATED
  RINGING
  CONNECTED
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY
  CANCELLED
  VOICEMAIL
}

enum CallDirection {
  OUTBOUND
  INBOUND
}

enum TelephonyProvider {
  TWILIO
  EXOTEL
  PLIVO
  RETELL
  VAPI
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  AZURE_OPENAI
}

enum ImportJobStatus {
  UPLOADED
  VALIDATED
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportRowStatus {
  PENDING
  VALID
  INVALID
  IMPORTED
  FAILED
}

model Workspace {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String
  slug                   String                  @unique
  metadata               Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  users                  User[]
  customers              Customer[]
  orders                 Order[]
  aiAgents               AiAgent[]
  knowledgeBases         KnowledgeBase[]
  marketplaceConnections MarketplaceConnection[]
  importJobs             ImportJob[]
  automations            Automation[]
  workspaceSettings      WorkspaceSettings?
  telephonyConfigs       TelephonyConfig[]
  aiProviderConfigs      AiProviderConfig[]
  calls                  Call[]

  @@index([deletedAt])
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @db.Uuid
  name         String
  email        String    @unique
  passwordHash String?
  role         String    @default("ADMIN")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([deletedAt])
}

model Customer {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  name        String
  phone       String
  email       String?
  language    String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orders      Order[]
  calls       Call[]

  @@index([workspaceId])
  @@index([phone])
  @@index([workspaceId, deletedAt])
}

model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  workspaceId        String      @db.Uuid
  customerId         String      @db.Uuid
  marketplace        Marketplace
  marketplaceOrderId String?
  paymentType        PaymentType
  status             OrderStatus @default(PENDING)
  totalAmount        Decimal     @db.Decimal(12, 2)
  currency           String      @default("INR") @db.VarChar(3)
  shippingAddress    Json?
  notes              String?
  metadata           Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?
  workspace          Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer           Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  callQueue          CallQueue[]
  calls              Call[]

  @@unique([workspaceId, marketplace, marketplaceOrderId])
  @@index([customerId])
  @@index([marketplaceOrderId])
  @@index([status])
  @@index([workspaceId, deletedAt])
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  name      String
  sku       String?
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model AiAgent {
  id              String         @id @default(uuid()) @db.Uuid
  workspaceId     String         @db.Uuid
  knowledgeBaseId String?        @db.Uuid
  name            String
  description     String?
  provider        String
  model           String
  voice           String
  language        String
  systemPrompt    String?
  greeting        String?
  temperature     Float          @default(0.7)
  isActive        Boolean        @default(true)
  configuration   Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledgeBase   KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  callQueue       CallQueue[]

  @@index([workspaceId])
  @@index([knowledgeBaseId])
  @@index([workspaceId, deletedAt])
}

model CallQueue {
  id           String      @id @default(uuid()) @db.Uuid
  orderId      String      @db.Uuid
  aiAgentId    String?     @db.Uuid
  status       QueueStatus @default(QUEUED)
  scheduledAt  DateTime?
  attemptCount Int         @default(0)
  lastError    String?
  startedAt    DateTime?
  completedAt  DateTime?
  lockedAt     DateTime?
  workerId     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  aiAgent      AiAgent?    @relation(fields: [aiAgentId], references: [id], onDelete: Restrict)
  calls        Call[]

  @@index([orderId])
  @@index([aiAgentId])
  @@index([status])
  @@index([scheduledAt])
  @@index([lockedAt])
}

model Call {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @db.Uuid
  orderId         String            @db.Uuid
  customerId      String            @db.Uuid
  callQueueId     String            @db.Uuid
  provider        TelephonyProvider
  providerCallId  String?
  phoneNumber     String
  status          CallStatus
  direction       CallDirection     @default(OUTBOUND)
  startedAt       DateTime?
  answeredAt      DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  recordingUrl    String?
  hangupReason    String?
  providerPayload Json?
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  callQueue       CallQueue         @relation(fields: [callQueueId], references: [id], onDelete: Cascade)
  transcript      Transcript?

  @@index([workspaceId])
  @@index([orderId])
  @@index([customerId])
  @@index([callQueueId])
  @@index([startedAt])
  @@index([providerCallId])
}

/// Durable dedup record for provider webhook deliveries. Providers (Plivo
/// included) may redeliver the same event on transient failures; a unique
/// constraint on (provider, providerCallId, eventType) is the idempotency
/// boundary -- a second delivery of the same lifecycle transition for the
/// same call is recognized and ignored rather than double-applied.
model TelephonyWebhookEvent {
  id             String            @id @default(uuid()) @db.Uuid
  provider       TelephonyProvider
  providerCallId String
  eventType      String
  payload        Json
  receivedAt     DateTime          @default(now())

  @@unique([provider, providerCallId, eventType])
  @@index([providerCallId])
}

model Transcript {
  id        String   @id @default(uuid()) @db.Uuid
  callId    String   @unique @db.Uuid
  content   String
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
}

model KnowledgeBase {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  title       String
  description String?
  content     String?
  sourceUrl   String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  aiAgents    AiAgent[]

  @@index([workspaceId])
  @@index([workspaceId, deletedAt])
}

model MarketplaceConnection {
  id                String      @id @default(uuid()) @db.Uuid
  workspaceId       String      @db.Uuid
  marketplace       Marketplace
  credentials       Json
  externalAccountId String?
  lastSyncedAt      DateTime?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?
  workspace         Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, marketplace])
  @@index([workspaceId])
  @@index([workspaceId, deletedAt])
}

model ImportJob {
  id               String          @id @default(uuid()) @db.Uuid
  workspaceId      String          @db.Uuid
  source           Marketplace
  sourceReference  String?
  status           ImportJobStatus @default(UPLOADED)
  fileName         String
  fileType         String
  headers          Json
  suggestedMapping Json
  fieldMapping     Json?
  totalRows        Int             @default(0)
  validRows        Int             @default(0)
  invalidRows      Int             @default(0)
  processedRows    Int             @default(0)
  successCount     Int             @default(0)
  errorCount       Int             @default(0)
  completedAt      DateTime?
  errorMessage     String?
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rows             ImportRow[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

model ImportRow {
  id          String          @id @default(uuid()) @db.Uuid
  importJobId String          @db.Uuid
  rowNumber   Int
  rawData     Json
  mappedData  Json?
  groupKey    String?
  status      ImportRowStatus @default(PENDING)
  errors      Json?
  customerId  String?         @db.Uuid
  orderId     String?         @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  importJob   ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@index([importJobId, status])
  @@index([importJobId, groupKey])
}

model Automation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  name        String
  description String?
  definition  Json
  isEnabled   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
}

/// Single source of truth for a workspace's general configuration. Future
/// provider modules (Telephony, AI, Email, WhatsApp, SMS, Billing, ...)
/// read their non-secret configuration from here.
model WorkspaceSettings {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @unique @db.Uuid
  timezone      String    @default("UTC")
  businessName  String?
  businessEmail String?
  businessPhone String?
  website       String?
  logoUrl       String?
  address       String?
  currency      String    @default("INR") @db.VarChar(3)
  language      String    @default("en")
  businessHours Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Telephony provider credentials for a workspace. `authToken` is encrypted
/// at rest (see EncryptionService) and must never be returned by any API.
/// Multiple rows may exist per workspace (history across provider
/// switches); at most one is `isActive` at a time.
model TelephonyConfig {
  id            String            @id @default(uuid()) @db.Uuid
  workspaceId   String            @db.Uuid
  provider      TelephonyProvider
  authId        String?
  authToken     String
  phoneNumber   String?
  webhookSecret String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, isActive])
}

/// AI provider credentials for a workspace. `apiKey` is encrypted at rest
/// (see EncryptionService) and must never be returned by any API. Multiple
/// rows may exist per workspace; at most one is `isActive` at a time.
model AiProviderConfig {
  id            String     @id @default(uuid()) @db.Uuid
  workspaceId   String     @db.Uuid
  provider      AiProvider
  apiKey        String
  defaultModel  String?
  temperature   Float      @default(0.7)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, isActive])
}
