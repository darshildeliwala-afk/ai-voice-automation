NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_voice_automation?schema=public"

# JWT authentication
JWT_SECRET=changeme
JWT_EXPIRES_IN=7d

# Encryption key for reversible field-level encryption (EncryptionService)
APP_ENCRYPTION_KEY=changeme

# Public HTTPS base URL this app is reachable at -- used to build the
# answerUrl/hangupUrl handed to telephony providers and to reconstruct the
# exact URL for webhook signature validation.
TELEPHONY_WEBHOOK_BASE_URL=changeme
