{
  "rootDir": "..",
  "testEnvironment": "node",
  "moduleFileExtensions": ["js", "json", "ts"],
  "testRegex": "test/integration/.*\\.integration-spec\\.ts$",
  "setupFiles": ["dotenv/config"],
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.spec.json" }]
  },
  "testTimeout": 30000,
  "forceExit": true
}
